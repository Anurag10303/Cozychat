PORT=3000
NODE_ENV=development
MONGODB_URL=
JWT_SECRET=
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL(s) allowed to call this API and open sockets, comma-separated.
# localhost:5173 and https://cozychat1.onrender.com are always allowed.
CLIENT_URL=http://localhost:5173

# Google sign-in: OAuth 2.0 "Web application" client ID from Google Cloud Console.
# This single value powers the Google button on every environment.
# In the console, add each URL from CLIENT_URL under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
